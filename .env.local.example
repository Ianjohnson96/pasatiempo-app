# Copy to .env.local and fill in from the HUB Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Caddie sign-in links are built from NEXT_PUBLIC_SITE_URL. Set it in production
# or the QR codes take their host from the request header and can point at the
# wrong place.

# Shared secret for the nightly housekeeping cron (/api/cron/caddie). Vercel
# sends it as "Authorization: Bearer <secret>". Left unset, the route stays
# closed rather than running for anyone who finds the URL.
CRON_SECRET=

# Web push for caddie job alerts. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is sent to the browser; the private key must stay server-side.
# Without both, posting a loop still works but notifies nobody.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourclub.com

# Report reminder emails for the Merchandise Program (/api/cron/merch, each
# morning at about 8 am Pacific). Use the same kind of mailbox Supabase sends
# password resets through (supabase/auth-email-setup.md). Without SMTP_HOST,
# SMTP_USER and SMTP_PASS the reminders show in the app only.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pasatiempo Pro Shop <noreply@pasatiempo.com>"
